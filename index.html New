<script>
(function(){
  'use strict';
  /* ---------- Année ---------- */
  document.getElementById('year').textContent = new Date().getFullYear();

  /* ---------- Header au scroll ---------- */
  var header = document.getElementById('header');
  function onScroll(){
    if (window.scrollY > 60){ header.classList.add('scrolled'); }
    else { header.classList.remove('scrolled'); }
  }
  window.addEventListener('scroll', onScroll, {passive:true});
  onScroll();

  /* ---------- Menu mobile ---------- */
  var trigger = document.getElementById('mainMenu-trigger');
  var mainMenu = document.getElementById('mainMenu');
  var overlay = document.getElementById('menuOverlay');
  function closeMenu(){
    trigger.classList.remove('open');
    mainMenu.classList.remove('open');
    overlay.classList.remove('open');
    document.body.style.overflow = '';
  }
  if (trigger) {
    trigger.querySelector('a').addEventListener('click', function(e){
      e.preventDefault();
      var isOpen = mainMenu.classList.contains('open');
      if (isOpen) { closeMenu(); }
      else {
        trigger.classList.add('open');
        mainMenu.classList.add('open');
        overlay.classList.add('open');
        document.body.style.overflow = 'hidden';
      }
    });
    overlay.addEventListener('click', closeMenu);
  }
  /* Dropdowns mobiles : clic pour ouvrir */
  document.querySelectorAll('#mainMenu li.dropdown > a').forEach(function(a){
    a.addEventListener('click', function(e){
      if (window.innerWidth <= 991) {
        var li = a.parentElement;
        if (!li.classList.contains('open')) {
          e.preventDefault();
          document.querySelectorAll('#mainMenu li.dropdown.open').forEach(function(o){
            if (o !== li) o.classList.remove('open');
          });
          li.classList.add('open');
        }
      }
    });
  });
  /* Fermer le menu quand on clique un lien (mobile) */
  document.querySelectorAll('#mainMenu a').forEach(function(a){
    a.addEventListener('click', function(){
      if (window.innerWidth <= 991 && !a.parentElement.classList.contains('dropdown')) closeMenu();
    });
  });

  /* ---------- Slider ---------- */
  var slides = Array.prototype.slice.call(document.querySelectorAll('#slider .slide'));
  var dots = Array.prototype.slice.call(document.querySelectorAll('.slider-dots .dot'));
  var current = 0, timer = null, DURATION = 6000;
  function showSlide(i){
    current = (i + slides.length) % slides.length;
    slides.forEach(function(s, n){ s.classList.toggle('active', n === current); });
    dots.forEach(function(d, n){ d.classList.toggle('active', n === current); });
  }
  function autoplay(){ clearInterval(timer); timer = setInterval(function(){ showSlide(current + 1); }, DURATION); }
  dots.forEach(function(d){
    d.addEventListener('click', function(){ showSlide(+d.dataset.slide); autoplay(); });
  });
  document.querySelector('.slider-arrow.prev').addEventListener('click', function(){ showSlide(current - 1); autoplay(); });
  document.querySelector('.slider-arrow.next').addEventListener('click', function(){ showSlide(current + 1); autoplay(); });
  /* Swipe tactile */
  var startX = null;
  var sliderEl = document.getElementById('slider');
  sliderEl.addEventListener('touchstart', function(e){ startX = e.touches[0].clientX; }, {passive:true});
  sliderEl.addEventListener('touchend', function(e){
    if (startX === null) return;
    var dx = e.changedTouches[0].clientX - startX;
    if (Math.abs(dx) > 50) { showSlide(current + (dx < 0 ? 1 : -1)); autoplay(); }
    startX = null;
  }, {passive:true});
  autoplay();

  /* ---------- Animations reveal ---------- */
  var animated = document.querySelectorAll('.animated');
  if ('IntersectionObserver' in window) {
    var obs = new IntersectionObserver(function(entries){
      entries.forEach(function(en){
        if (en.isIntersecting) {
          var delay = en.target.dataset.animateDelay || 0;
          setTimeout(function(){ en.target.classList.add('visible'); }, +delay);
          obs.unobserve(en.target);
        }
      });
    }, {threshold:.12, rootMargin:'0px 0px -40px 0px'});
    animated.forEach(function(el){ obs.observe(el); });
  } else {
    animated.forEach(function(el){ el.classList.add('visible'); });
  }

  /* ---------- Compteurs animés ---------- */
  function animateCounter(el){
    var to = +el.dataset.to, start = null, DUR = 2000;
    function step(ts){
      if (!start) start = ts;
      var p = Math.min((ts - start) / DUR, 1);
      el.textContent = Math.floor(to * (1 - Math.pow(1 - p, 3)));
      if (p < 1) requestAnimationFrame(step);
      else el.textContent = to;
    }
    requestAnimationFrame(step);
  }
  var counters = document.querySelectorAll('.counter-value');
  if ('IntersectionObserver' in window) {
    var cobs = new IntersectionObserver(function(entries){
      entries.forEach(function(en){
        if (en.isIntersecting) { animateCounter(en.target); cobs.unobserve(en.target); }
      });
    }, {threshold:.5});
    counters.forEach(function(c){ cobs.observe(c); });
  } else {
    counters.forEach(function(c){ c.textContent = c.dataset.to; });
  }

  /* ---------- Formulaire contact (mailto) ---------- */
  document.getElementById('contactForm').addEventListener('submit', function(e){
    e.preventDefault();
    var n = document.getElementById('name').value.trim();
    var em = document.getElementById('email').value.trim();
    var c = document.getElementById('collection').value || 'Non précisée';
    var m = document.getElementById('message').value.trim();
    var subject = encodeURIComponent('Projet éditorial — ' + c);
    var body = encodeURIComponent('Bonjour Kor\u2019Art Éditions,\n\nNom : ' + n + '\nEmail : ' + em + '\nCollection : ' + c + '\n\nMessage :\n' + m);
    window.location.href = 'mailto:contact.korarteditions@gmail.com?subject=' + subject + '&body=' + body;
    document.getElementById('formNote').textContent = 'Votre logiciel de messagerie va s\u2019ouvrir pour préparer l\u2019envoi.';
  });
})();
</script>
