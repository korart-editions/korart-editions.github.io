<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="Kor'Art Éditions — maison d'édition basée à Lomé, dédiée à la publication, à l'accompagnement des auteurs et à la transmission des idées.">
<title>Kor'Art Éditions — Maison d'édition à Lomé, Togo</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500;1,600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
<style>
/* ==========================================================================
   KOR'ART ÉDITIONS — Design System (calqué sur editionsazur.com)
   Palette + typographie + composants
   ========================================================================== */
:root{
  --azur-primary:#0f2c4b;
  --azur-primary-dark:#0a1f37;
  --azur-primary-light:#1e4372;
  --azur-black:#0a0a0a;
  --azur-black-soft:#1a1a1a;
  --azur-white:#ffffff;
  --azur-white-off:#f7f7f9;
  --azur-ink:#0a0a0a;
  --azur-ink-soft:#3a3a3a;
  --azur-mute:#8a8a8a;
  --azur-line:#e6e6ea;
  --azur-cta:#2250fc;
  --azur-cta-dark:#1a3fd0;
  --radius-sm:4px;
  --radius-md:8px;
  --radius-lg:14px;
  --shadow-sm:0 2px 6px rgba(15,44,75,.06);
  --shadow-md:0 6px 20px rgba(15,44,75,.08);
  --shadow-lg:0 16px 40px rgba(15,44,75,.12);
  --transition:200ms ease;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:'Poppins',sans-serif;color:var(--azur-ink);background:var(--azur-white);line-height:1.7;font-size:16px;overflow-x:hidden}
a{color:var(--azur-primary);transition:color var(--transition)}
a:hover{color:var(--azur-black)}
img{max-width:100%;display:block}
h1,h2,h3,h4,h5,h6{color:var(--azur-primary);line-height:1.3}
.container{width:min(1140px,calc(100% - 40px));margin:0 auto}
section{padding:100px 0}
.text-center{text-align:center}
p.lead{font-size:17px;color:var(--azur-ink-soft);max-width:780px;margin:14px auto 0}

/* ------------------ Boutons ------------------ */
.btn,button.btn,a.btn{
  display:inline-block;font-family:inherit;font-weight:600;font-size:14px;letter-spacing:.04em;
  padding:12px 28px;border-radius:var(--radius-sm);border:2px solid var(--azur-primary);
  background:var(--azur-primary);color:var(--azur-white);cursor:pointer;text-decoration:none;
  transition:all var(--transition);text-transform:uppercase;line-height:1.5
}
.btn:hover,a.btn:hover,button.btn:hover{
  background:var(--azur-primary-dark);border-color:var(--azur-primary-dark);color:var(--azur-white);
  transform:translateY(-1px);box-shadow:var(--shadow-md)
}
.btn-outline,a.btn-outline{background:transparent;color:var(--azur-primary)}
.btn-outline:hover,a.btn-outline:hover{background:var(--azur-primary);color:var(--azur-white)}
.btn-inverted,a.btn-inverted{background:transparent;border-color:var(--azur-white);color:var(--azur-white)}
.btn-inverted:hover,a.btn-inverted:hover{background:var(--azur-white);color:var(--azur-primary)}
.btn-white,a.btn-white{background:#fff;color:var(--azur-primary);border-color:#fff}
.btn-white:hover,a.btn-white:hover{background:rgba(255,255,255,.88);color:var(--azur-primary);border-color:#fff}
.btn-slider{background:var(--azur-cta);border-color:var(--azur-cta);color:#fff}
.btn-slider:hover{background:var(--azur-cta-dark);border-color:var(--azur-cta-dark);color:#fff;transform:translateY(-1px);box-shadow:0 8px 24px rgba(34,80,252,.35)}

/* ------------------ En-têtes de section ------------------ */
.heading-section{text-align:center;margin-bottom:48px}
.heading-section h2{font-size:clamp(1.8rem,3vw,2.4rem);font-weight:700;margin:0}
.heading-section .lead{font-size:16.5px;color:var(--azur-ink-soft);max-width:760px;margin:14px auto 0}

/* ------------------ Header ------------------ */
#header{
  position:fixed;top:0;left:0;right:0;z-index:1000;
  transition:background-color var(--transition),box-shadow var(--transition),transform var(--transition);
  background:linear-gradient(180deg,rgba(10,31,55,.55),rgba(10,31,55,0))
}
#header .header-inner{display:flex;align-items:center;justify-content:space-between;height:86px;transition:height var(--transition)}
#logo a{display:flex;align-items:center;text-decoration:none}
#logo img{height:52px;width:auto;transition:height var(--transition)}
#logo .logo-dark{display:none}
#logo .logo-default{display:block}
#mainMenu nav>ul{display:flex;align-items:center;gap:6px;list-style:none;margin:0;padding:0}
#mainMenu nav>ul>li{position:relative}
#mainMenu nav>ul>li>a{
  display:block;color:#fff;font-weight:600;font-size:13px;letter-spacing:.06em;
  padding:10px 13px;text-decoration:none;text-transform:uppercase;white-space:nowrap
}
#mainMenu nav>ul>li>a:hover,#mainMenu nav>ul>li.current>a{color:#fff;background:rgba(255,255,255,.12);border-radius:var(--radius-sm)}
#mainMenu nav>ul>li>a.menu-cta{
  background:var(--azur-cta);color:#fff!important;border-radius:var(--radius-sm);
  padding:10px 18px!important;margin-left:10px;box-shadow:var(--shadow-sm)
}
#mainMenu nav>ul>li>a.menu-cta:hover{background:var(--azur-cta-dark)!important;transform:translateY(-1px)}
.dropdown-arrow{
  position:absolute;right:8px;top:14px;width:0;height:0;pointer-events:none;
  border-left:4px solid transparent;border-right:4px solid transparent;border-top:4px solid currentColor;opacity:.7
}
.dropdown-menu{
  position:absolute;top:calc(100% + 10px);left:0;min-width:230px;list-style:none;margin:0;padding:10px 0;
  background:#fff;border-radius:var(--radius-md);box-shadow:var(--shadow-lg);border:1px solid var(--azur-line);
  opacity:0;visibility:hidden;transform:translateY(10px);transition:all var(--transition)
}
.dropdown-menu:before{
  content:'';position:absolute;top:-6px;left:18px;width:12px;height:12px;background:#fff;
  transform:rotate(45deg);border-left:1px solid var(--azur-line);border-top:1px solid var(--azur-line)
}
.dropdown-menu li a{
  display:block;padding:9px 22px;font-size:14px;font-weight:400;color:var(--azur-ink-soft);
  text-decoration:none;text-transform:none;letter-spacing:0;white-space:nowrap
}
.dropdown-menu li a:hover{color:var(--azur-primary);background:var(--azur-white-off)}
li.dropdown:hover>.dropdown-menu{opacity:1;visibility:visible;transform:translateY(0)}
#mainMenu-trigger{display:none}
/* Header scrollé : fond blanc + logo couleur */
#header.scrolled{background:rgba(255,255,255,.97);box-shadow:var(--shadow-md);backdrop-filter:blur(10px)}
#header.scrolled .header-inner{height:72px}
#header.scrolled #logo .logo-dark{display:block}
#header.scrolled #logo .logo-default{display:none}
#header.scrolled #logo img{height:46px}
#header.scrolled #mainMenu nav>ul>li>a{color:var(--azur-ink)}
#header.scrolled #mainMenu nav>ul>li>a:hover,#header.scrolled #mainMenu nav>ul>li.current>a{color:var(--azur-black);background:rgba(15,44,75,.07)}
#header.scrolled #mainMenu nav>ul>li>a.menu-cta{color:#fff!important}

/* ------------------ Slider fullscreen ------------------ */
#slider{position:relative;height:100vh;min-height:560px;overflow:hidden;background:var(--azur-primary-dark)}
#slider .slide{position:absolute;inset:0;opacity:0;visibility:hidden;transition:opacity 800ms ease,visibility 800ms}
#slider .slide.active{opacity:1;visibility:visible;z-index:2}
#slider .slide .slide-bg{position:absolute;inset:0;background-size:cover;background-position:center;transform:scale(1);animation:kenburns 14s ease-out infinite alternate}
#slider .slide.active .slide-bg{animation-name:kenburns-active}
#slider .slide .bg-overlay{
  position:absolute;inset:0;
  background:linear-gradient(180deg,rgba(10,31,55,.5) 0%,rgba(10,31,55,.35) 45%,rgba(10,31,55,.68) 100%)
}
#slider .slide .container{position:relative;z-index:3;height:100%;display:flex;align-items:center;justify-content:center;padding-top:70px}
.slide-captions{text-align:center;color:#fff;max-width:880px;padding:0 20px}
.slide-captions .strong{
  display:inline-block;font-size:14px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;
  color:rgba(255,255,255,.92);margin-bottom:18px;position:relative;padding-left:26px;padding-right:26px
}
.slide-captions .strong:before,.slide-captions .strong:after{
  content:'';position:absolute;top:50%;width:18px;height:1px;background:rgba(255,255,255,.55)
}
.slide-captions .strong:before{left:0}
.slide-captions .strong:after{right:0}
.slide-captions h2{
  color:#fff;font-size:clamp(2rem,4.6vw,3.4rem);font-weight:700;line-height:1.18;
  margin:0 0 30px;text-shadow:0 4px 30px rgba(10,31,55,.45)
}
.slide-captions .btn{margin-top:6px}
/* Apparition des captions */
#slider .slide .slide-captions>*{opacity:0;transform:translateY(26px);transition:opacity 700ms ease,transform 700ms ease}
#slider .slide.active .slide-captions>*{opacity:1;transform:translateY(0)}
#slider .slide.active .slide-captions>*:nth-child(1){transition-delay:250ms}
#slider .slide.active .slide-captions>*:nth-child(2){transition-delay:420ms}
#slider .slide.active .slide-captions>*:nth-child(3){transition-delay:600ms}
@keyframes kenburns-active{0%{transform:scale(1) translate(0,0)}100%{transform:scale(1.13) translate(-1.6%,1.2%)}}
@keyframes kenburns{0%{transform:scale(1.06) translate(0,0)}100%{transform:scale(1.06) translate(0,0)}}
/* Flèches */
.slider-arrow{
  position:absolute;top:50%;transform:translateY(-50%);z-index:10;width:48px;height:48px;
  border:none;border-radius:50%;background:rgba(255,255,255,.14);backdrop-filter:blur(6px);
  color:#fff;font-size:15px;cursor:pointer;transition:all var(--transition);display:grid;place-items:center
}
.slider-arrow:hover{background:var(--azur-cta)}
.slider-arrow.prev{left:26px}
.slider-arrow.next{right:26px}
/* Points */
.slider-dots{position:absolute;bottom:34px;left:0;right:0;z-index:10;display:flex;justify-content:center;gap:10px}
.slider-dots .dot{
  width:26px;height:3px;border:none;padding:0;cursor:pointer;background:rgba(255,255,255,.4);
  border-radius:2px;transition:all var(--transition)
}
.slider-dots .dot.active{background:#fff;width:44px}
.scroll-hint{
  position:absolute;bottom:78px;left:50%;transform:translateX(-50%);z-index:9;color:rgba(255,255,255,.75);
  font-size:12px;letter-spacing:.18em;text-transform:uppercase;display:flex;flex-direction:column;align-items:center;gap:8px;text-decoration:none
}
.scroll-hint i{animation:hint-bounce 1.8s ease-in-out infinite}
.scroll-hint:hover{color:#fff}
@keyframes hint-bounce{0%,100%{transform:translateY(0)}50%{transform:translateY(7px)}}

/* ------------------ Animations reveal ------------------ */
.animated{opacity:0;transform:translateY(30px);transition:opacity 700ms ease,transform 700ms ease}
.animated.visible{opacity:1;transform:translateY(0)}

/* ------------------ Grille ------------------ */
.row{display:flex;flex-wrap:wrap;margin:-15px}
.row>[class*="col-"]{padding:15px}
.col-lg-2{width:16.666%}
.col-lg-3{width:25%}
.col-lg-4{width:33.333%}
.col-lg-5{width:41.666%}
.col-lg-7{width:58.333%}
.col-md-6{width:50%}
.justify-content-center{justify-content:center}
@media (max-width:991px){
  .col-lg-2,.col-lg-3,.col-lg-4,.col-lg-5,.col-lg-7{width:50%}
}
@media (max-width:640px){
  .row{margin:-10px}
  .row>[class*="col-"]{padding:10px}
  .col-lg-2,.col-lg-3,.col-lg-4,.col-lg-5,.col-lg-7,.col-md-6{width:100%}
}
</style>
</head>

<style>
/* ------------------ Section bienvenue ------------------ */
#welcome{padding-bottom:0}
#welcome .img-fluid{width:100%;border-radius:var(--radius-lg)}

/* ------------------ Carte livre en vedette (À la une) ------------------ */
.azur-featured{
  display:flex;flex-direction:column;background:var(--azur-white);
  border:1px solid var(--azur-line);border-radius:var(--radius-lg);overflow:hidden;
  transition:transform var(--transition),box-shadow var(--transition)
}
.azur-featured:hover{transform:translateY(-5px);box-shadow:var(--shadow-lg)}
.azur-featured__cover{position:relative;display:block;background:var(--azur-white-off);text-decoration:none}
.azur-featured__cover img{width:100%;aspect-ratio:4/3;object-fit:contain;display:block;padding:26px}
.azur-featured__badge{
  position:absolute;top:12px;left:12px;background:var(--azur-cta);color:#fff;
  font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;
  padding:4px 12px;border-radius:20px
}
.azur-featured__body{padding:22px;display:flex;flex-direction:column;flex:1}
.azur-featured__author{font-size:13px;color:var(--azur-mute);margin-bottom:4px}
.azur-featured__title{font-size:19px;margin:0 0 10px;line-height:1.25;font-weight:600}
.azur-featured__excerpt{font-size:14px;line-height:1.65;color:var(--azur-ink-soft);flex:1;margin:0 0 16px}
.azur-featured__foot{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:6px}
.azur-featured__foot .btn{padding:9px 18px;font-size:12px}
.azur-featured__collection{font-weight:700;color:var(--azur-primary);font-size:15px}
.azur-featured__collection small{display:block;font-weight:400;font-size:12px;color:var(--azur-mute)}

/* ------------------ Icon boxes (services) ------------------ */
.icon-box{text-align:center;padding:34px 26px;background:#fff;border-radius:var(--radius-md);transition:transform var(--transition),box-shadow var(--transition)}
.icon-box .icon{
  width:86px;height:86px;margin:0 auto 20px;border-radius:50%;border:1px solid var(--azur-line);
  display:grid;place-items:center;background:#fff;transition:all var(--transition)
}
.icon-box .icon i{font-size:30px;color:var(--azur-primary);transition:color var(--transition)}
.icon-box:hover{transform:translateY(-5px);box-shadow:var(--shadow-md)}
.icon-box:hover .icon{border-color:var(--azur-primary);background:rgba(15,44,75,.05)}
.icon-box h3{font-size:17.5px;font-weight:600;margin:0 0 10px}
.icon-box p{font-size:14px;line-height:1.65;color:var(--azur-ink-soft);margin:0}

/* ------------------ Cartes livres (publications) ------------------ */
.azur-card{
  background:var(--azur-white);border:1px solid var(--azur-line);border-radius:var(--radius-md);
  overflow:hidden;transition:transform var(--transition),box-shadow var(--transition);
  display:flex;flex-direction:column;height:100%
}
a.azur-card{color:inherit;text-decoration:none}
a.azur-card:hover{color:inherit;transform:translateY(-6px);box-shadow:var(--shadow-lg)}
.azur-card__cover{position:relative;overflow:hidden;background:var(--azur-white-off)}
.azur-card__image{width:100%;aspect-ratio:4/3;object-fit:contain;display:block;padding:22px;transition:transform .5s ease}
a.azur-card:hover .azur-card__image{transform:scale(1.05)}
.azur-card__tag{
  position:absolute;top:12px;right:12px;background:var(--azur-cta);color:#fff;
  font-size:11.5px;font-weight:700;padding:5px 12px;border-radius:20px;box-shadow:var(--shadow-sm)
}
.azur-card__overlay{
  position:absolute;left:0;right:0;bottom:0;display:flex;align-items:center;justify-content:center;gap:8px;
  padding:13px;font-size:13px;font-weight:600;color:#fff;
  background:linear-gradient(to top,rgba(10,22,40,.9),rgba(10,22,40,0));
  opacity:0;transform:translateY(8px);transition:all var(--transition)
}
a.azur-card:hover .azur-card__overlay{opacity:1;transform:translateY(0)}
.azur-card__overlay i{transition:transform var(--transition)}
a.azur-card:hover .azur-card__overlay i{transform:translateX(4px)}
.azur-card__body{padding:18px;flex:1;display:flex;flex-direction:column}
.azur-card__meta{font-size:13px;color:var(--azur-mute);margin-bottom:8px}
.azur-card__title{font-size:17px;font-weight:600;color:var(--azur-primary);margin:0 0 6px;line-height:1.3}
.azur-card__author{margin:2px 0 0;color:var(--azur-mute);font-size:13px}

/* ------------------ Collections ------------------ */
.background-grey{background:var(--azur-white-off)}
.collections-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:22px}
.collection-card{
  background:#fff;border:1px solid var(--azur-line);border-radius:var(--radius-md);
  padding:30px 22px;text-align:center;position:relative;overflow:hidden;
  transition:transform var(--transition),box-shadow var(--transition)
}
.collection-card:hover{transform:translateY(-5px);box-shadow:var(--shadow-md)}
.collection-card__num{
  position:absolute;top:10px;right:16px;font-size:44px;font-weight:700;color:var(--azur-primary);opacity:.07;line-height:1
}
.collection-card__icon{
  width:64px;height:64px;margin:0 auto 16px;border-radius:50%;display:grid;place-items:center;
  background:rgba(15,44,75,.07);color:var(--azur-primary);font-size:24px;transition:all var(--transition)
}
.collection-card:hover .collection-card__icon{background:var(--azur-primary);color:#fff}
.collection-card__title{font-size:17px;font-weight:600;margin:0 0 10px}
.collection-card__text{font-size:13.5px;line-height:1.6;color:var(--azur-ink-soft);margin:0}
@media (max-width:1100px){.collections-grid{grid-template-columns:repeat(3,1fr)}}
@media (max-width:760px){.collections-grid{grid-template-columns:repeat(2,1fr)}}
@media (max-width:520px){.collections-grid{grid-template-columns:1fr}}

/* ------------------ À propos / maison ------------------ */
.azur-about__photo{max-width:100%;border-radius:var(--radius-lg);box-shadow:var(--shadow-md)}
.azur-about__eyebrow{
  display:inline-block;font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;
  color:var(--azur-cta);margin-bottom:10px
}
.azur-about__title{font-size:clamp(1.6rem,3vw,2.2rem);margin:0 0 16px}
.azur-about__text{font-size:16px;line-height:1.8;color:var(--azur-ink-soft);margin:0 0 24px}
.about-values{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin:26px 0 30px}
.about-value{display:flex;gap:12px;align-items:flex-start;background:var(--azur-white-off);border-radius:var(--radius-md);padding:14px 16px}
.about-value i{color:var(--azur-cta);font-size:16px;margin-top:4px}
.about-value strong{display:block;font-size:14px;color:var(--azur-primary)}
.about-value span{font-size:12.5px;color:var(--azur-ink-soft);line-height:1.5;display:block}
@media (max-width:640px){.about-values{grid-template-columns:1fr}}

/* ------------------ Compteurs parallax ------------------ */
.counters{
  position:relative;padding:130px 0;color:#fff;
  background-image:url("data:image/jpeg;base64,");background-size:cover;background-position:center;background-attachment:fixed
}
.counters:before{content:'';position:absolute;inset:0;background:rgba(10,31,55,.78)}
.counters .container{position:relative;z-index:2}
.counter-item{text-align:center;padding:0 12px}
.counter-item .icon{margin-bottom:16px}
.counter-item .icon i{font-size:34px;color:rgba(255,255,255,.9)}
.counter-item .counter{font-size:46px;font-weight:700;line-height:1.1;color:#fff}
.counter-item .seperator{width:44px;height:2px;background:rgba(255,255,255,.35);margin:16px auto}
.counter-item p{font-size:13.5px;letter-spacing:.18em;text-transform:uppercase;color:rgba(255,255,255,.85);margin:0}
@media (max-width:768px){.counters{background-attachment:scroll}}

/* ------------------ Auteurs ------------------ */
.azur-author{display:block;text-align:center;text-decoration:none}
.azur-author__initial{
  width:130px;height:130px;border-radius:50%;margin:0 auto 16px;display:grid;place-items:center;
  background:linear-gradient(135deg,var(--azur-primary),var(--azur-primary-light));
  color:#fff;font-size:44px;font-weight:700;border:4px solid #fff;box-shadow:var(--shadow-sm);
  transition:transform var(--transition),box-shadow var(--transition)
}
.azur-author:hover .azur-author__initial{transform:translateY(-4px);box-shadow:var(--shadow-md)}
.azur-author__name{font-weight:600;color:var(--azur-primary);font-size:16.5px}
.azur-author__count{font-size:13px;color:var(--azur-mute)}

/* ------------------ Étapes (publier) ------------------ */
.azur-step{
  height:100%;padding:28px 24px;border:1px solid var(--azur-line);border-radius:var(--radius-md);
  background:var(--azur-white);box-shadow:var(--shadow-sm);
  transition:transform var(--transition),box-shadow var(--transition)
}
.azur-step:hover{transform:translateY(-4px);box-shadow:var(--shadow-md)}
.azur-step__num{
  display:inline-grid;place-items:center;width:42px;height:42px;margin-bottom:14px;
  border-radius:50%;background:var(--azur-cta);color:#fff;font-size:18px;font-weight:700
}
.azur-step__title{font-size:17px;margin:0 0 8px;color:var(--azur-primary);font-weight:600}
.azur-step__text{margin:0;font-size:13.5px;line-height:1.65;color:var(--azur-ink-soft)}
.publier-note{
  max-width:760px;margin:38px auto 0;padding:16px 22px;background:var(--azur-white-off);
  border-left:4px solid var(--azur-primary);border-radius:var(--radius-sm);
  font-size:14px;color:var(--azur-ink-soft);line-height:1.7
}

/* ------------------ Bandeau CTA ------------------ */
